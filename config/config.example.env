# Copy to config/local.env and edit for the Open5GS instance used by the reviewer.
# This address must match /etc/open5gs/amf.yaml under ngap.server.
# Open5GS installations commonly use 127.0.0.5; 127.0.0.1 is only an example.
AMF_IP=127.0.0.5
AMF_PORT=38412
SCTP_ENDPOINT=sctp://127.0.0.5/38412
OPEN5GS_AMFD=/path/to/open5gs/install/bin/open5gs-amfd
